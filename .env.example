# Copy to .env or .env.local. Process variables take precedence.
# QR login commands update .env.local:
#   pk wechat login
#   pk bilibili login

# WeChat Channels requires hy_user and a session token.
# YUANBAO_COOKIE="hy_user=...; hy_token=...; ..."

# Optional higher-quality Bilibili access; requires SESSDATA.
# BILIBILI_COOKIE="SESSDATA=...; bili_jct=...; DedeUserID=..."

# Download directory; created on demand.
PARSE_KIT_OUTPUT_DIR=./downloads

# Absolute `ffprobe` path; omit to search `PATH`.
# FFPROBE_PATH=/usr/local/bin/ffprobe
