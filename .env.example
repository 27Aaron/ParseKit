# Copy this file to .env or .env.local and set the required values.
# The `pk` CLI loads .env.local then .env (does not override existing process env).
# CLI login helpers write into .env.local automatically:
#   pk wechat login
#   pk bilibili login

# Required for WeChat Channels (via Yuanbao). Must include hy_user / hy_token.
# Run `pk wechat login` and scan with WeChat. Manual browser cookies remain a fallback.
# YUANBAO_COOKIE="hy_user=...; hy_token=...; ..."

# Optional: Bilibili web cookie for higher play quality (SESSDATA required).
# Paste from browser DevTools, or run: pk bilibili login
# BILIBILI_COOKIE="SESSDATA=...; bili_jct=...; DedeUserID=..."

# Directory for `pk download` output; created on demand.
PARSE_KIT_OUTPUT_DIR=./downloads

# Absolute `ffprobe` path; omit to search `PATH`.
# FFPROBE_PATH=/usr/local/bin/ffprobe
