# Copy to .env or .env.local and fill in values.
# Loaded automatically by the `pk` CLI (does not override existing env).

# WeChat Channels (Yuanbao) cookie — required when resolving WeChat links.
YUANBAO_COOKIE=

# Default media workspace for `pk download` (created if missing).
PARSE_KIT_OUTPUT_DIR=./downloads

# Max download size in bytes (default 200 MiB).
PARSE_KIT_MAX_BYTES=209715200

# Optional absolute path to ffprobe (otherwise PATH is searched).
# FFPROBE_PATH=/usr/local/bin/ffprobe
