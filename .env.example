# Copy this file to .env or .env.local and set the required values.
# The `pk` CLI loads either file without overriding existing variables.

# Required for resolving WeChat Channels links through Yuanbao.
YUANBAO_COOKIE=

# Directory for `pk download` output; created on demand.
PARSE_KIT_OUTPUT_DIR=./downloads

# Absolute `ffprobe` path; omit to search `PATH`.
# FFPROBE_PATH=/usr/local/bin/ffprobe
